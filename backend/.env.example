# Chép thành backend/.env rồi điền giá trị. TUYỆT ĐỐI không đưa .env lên GitHub.
# Chuỗi kết nối PostgreSQL. Chạy bằng chay_demo.py (SQLite) thì không cần dòng này.
DATABASE_URL=postgresql://postgres:THAY_MAT_KHAU_POSTGRES@localhost:5432/guidance_db
# ---- API nguồn dữ liệu thủ tục (CHỈ cần khi thu thập lại bằng crawler.py) ----
# Địa chỉ API, client id và tài khoản do đơn vị quản lý dữ liệu cấp; không công khai.
DVC_TOKEN_URL=
DVC_CLIENT_ID=
DVC_USERNAME=
DVC_PASSWORD=
DVC_PROCEDURES_URL=

# ---- Khu vực cán bộ (bổ sung 08/10/2026) ----
# Để trống thì trang cán bộ bị khóa. Tự đặt tài khoản và mật khẩu của bạn.
QUAN_TRI_TAI_KHOAN=
QUAN_TRI_MAT_KHAU=
# Chuỗi bí mật để ký mã phiên đăng nhập (tùy chọn; để trống thì máy chủ tự sinh mỗi lần khởi động)
BI_MAT_PHIEN=

# ---- Lớp mô hình ngôn ngữ cho trợ lý (TÙY CHỌN, để trống = tắt) ----
# Trợ lý vẫn chạy đầy đủ khi tắt. Chỉ bật khi được người hướng dẫn cho phép.
# Dùng API tương thích chuẩn OpenAI "chat/completions". Ví dụ Ollama chạy tại máy:
#   LLM_BASE_URL=http://localhost:11434/v1
#   LLM_MODEL=qwen2.5:7b
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=

# ---- Khi đưa lên mạng (bổ sung 20/10/2026; trên máy cá nhân để nguyên) ----
# Số lượt/phút mỗi IP được gọi tra cứu, trợ lý, đăng nhập cán bộ (0 = tắt). Render: 30.
# GIOI_HAN_MOI_PHUT=30
# Đứng sau proxy của dịch vụ đám mây: lấy IP người dùng ở mục thứ N tính từ cuối
# X-Forwarded-For (0 = dùng địa chỉ kết nối trực tiếp). Render: 2. Xem backend/app/mang.py.
# SO_PROXY_TIN_CAY=2
# Số ngày giữ nhật ký tra cứu (mặc định 180; 0 = giữ mãi)
# NHAT_KY_GIU_NGAY=180
# Chỉ cho trang ở tên miền này gọi API từ trình duyệt (mặc định mọi nơi; API cán bộ vẫn cần đăng nhập)
# CORS_ORIGINS=https://ten-mien-cua-ban
# Chạy MỘT tiến trình máy chủ (không dùng --workers > 1): bộ đếm lượt, khóa đăng nhập sai và
# danh sách mã phiên đã đăng xuất nằm trong bộ nhớ của tiến trình.

# ---- Lớp hiểu câu hỏi (bỏ từ đệm, đổi từ đồng nghĩa) ----
# Mặc định bật. Đặt 0 để tra cứu chỉ dùng câu gốc, giống hệt bản 29/09.
# Xem mục 3 của 08_PHAN_HOI_DANH_GIA_20261009.md trước khi quyết định.
# HIEU_CAU_HOI=0
